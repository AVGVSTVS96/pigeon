{
  "name": "@avgvstvs96/pigeon",
  "version": "0.1.0",
  "description": "Your messages, from the terminal. An iMessage CLI with pluggable sources and filters.",
  "keywords": [
    "agents",
    "chat.db",
    "cli",
    "imessage",
    "messages",
    "redaction"
  ],
  "license": "MIT",
  "repository": "github:AVGVSTVS96/pigeon",
  "bin": {
    "pigeon": "src/cli/main.ts"
  },
  "files": [
    "src",
    "examples",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "oxlint && oxfmt --check && tsc && bun test",
