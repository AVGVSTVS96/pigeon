    "prepare": "lefthook install",
    "test": "bun test",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.3"
}
